{
  "_doc": "ETH student cluster, GB10 node (20 ARM cores: 10 Cortex-X925 + 10 Cortex-A725, 112 GiB RAM per job, 850 GiB local /tmp, 24 h limit). Second architecture (aarch64) and the largest traces (1e9 records, ~46 GB in legacy form). Single-process runs are pinned to the fastest core (cpu_capacity); the 'little_cores' experiment pins to the slowest. Experiments run in this order; --budget-hours 22 stops before the job limit.",
  "include": ["builds.json", "configs.json"],
  "repetitions": {"warmup": 1, "min": 10, "max": 50, "ci_rel": 0.05, "confidence": 0.95,
                  "caps": [{"min_records": 5e6, "min": 10, "max": 20}, {"min_records": 5e7, "min": 5, "max": 8},
                           {"min_records": 5e8, "min": 3, "max": 3}]},
  "environment": {"pin": true, "membind": true, "env_padding": true, "noisy_loadavg_per_cpu": 0.5,
                  "timeout_s": 10800, "cache_method": "auto"},
  "check": {"viz_max_records": 1000000, "byte_identity_max_records": 1000000},
  "trace_defaults": {"workload": "stencil3d", "ranks": 64, "records": 1e6, "schema": "inferred"},
  "experiments": [
    {"name": "size_sweep", "kind": "e2e",
     "traces": {"records": [1e4, 1e5, 1e6, 1e7, 1e8]},
     "configs": ["BASE", "NEW-legacyfile", "NEW-interp", "NEW-spec-cold", "NEW-spec-warm", "NEW-orc", "NEW-tnode",
                 "LAZY-legacyfile", "LAZY-interp", "LAZY-spec-warm"],
     "cache": ["warm"]},
    {"name": "breakeven", "kind": "e2e",
     "traces": {"records": [2e6, 5e6, 2e7, 5e7]},
     "configs": ["BASE", "NEW-interp", "NEW-spec-cold", "NEW-spec-warm"], "cache": ["warm"]},
    {"name": "rank_sweep", "kind": "e2e",
     "traces": {"ranks": [8, 64, 512, 4096, 32768], "records": [1e7]},
     "configs": ["BASE", "NEW-legacyfile", "NEW-interp", "NEW-spec-warm", "LAZY-interp"], "cache": ["warm"]},
    {"name": "schema_sweep", "kind": "e2e",
     "traces": {"schema": ["inferred", "custom", "wide"], "records": [1e6, 1e7]},
     "configs": ["BASE", "NEW-interp", "NEW-spec-warm", "NEW-tnode", "LAZY-interp"], "cache": ["warm"]},
    {"name": "workloads", "kind": "e2e",
     "traces": [{"workload": "stencil3d", "ranks": 64}, {"workload": "allreduce_ring", "ranks": 64},
                {"workload": "allreduce_rd", "ranks": 64}, {"workload": "alltoall", "ranks": 64},
                {"workload": "dp_nccl", "ranks": 16}, {"workload": "pipeline_1f1b", "ranks": 16},
                {"workload": "moe_alltoall", "ranks": 32}],
     "configs": ["BASE", "NEW-legacyfile", "NEW-interp", "NEW-spec-warm", "LAZY-interp"], "cache": ["warm"]},
    {"name": "cold_cache", "kind": "e2e",
     "traces": {"records": [1e6, 1e7, 1e8]},
     "configs": ["BASE", "NEW-legacyfile", "NEW-interp", "NEW-spec-cold", "NEW-spec-warm", "LAZY-interp"],
     "cache": ["cold"]},
    {"name": "instrumentation_overhead", "kind": "e2e",
     "traces": {"records": [1e6, 1e7]},
     "configs": ["NEW-interp", "NEW-interp-notiming", "PLAIN-interp"], "cache": ["warm"]},
    {"name": "save_mem", "kind": "e2e",
     "traces": {"records": [1e7, 1e8]},
     "configs": ["BASE-savemem", "NEW-savemem-interp", "BASE", "NEW-interp", "LAZY-interp"], "cache": ["warm"]},
    {"name": "decode_micro", "kind": "micro",
     "traces": {"records": [1e5, 1e6, 1e7, 1e8]},
     "variants": ["upstream", "legacy", "plan", "jit", "orc", "templated_node"],
     "orders": ["seq", "topo", "random"], "fields": ["sim"], "cache": ["warm"], "processes": 3, "reps": 10},
    {"name": "decode_micro_cold", "kind": "micro",
     "traces": {"records": [1e7, 1e8]},
     "variants": ["upstream", "legacy", "plan", "jit", "templated_node"],
     "orders": ["seq", "topo"], "fields": ["sim"], "cache": ["cold"], "processes": 2, "reps": 5},
    {"name": "little_cores", "kind": "micro",
     "_doc": "Same decode work pinned to an efficiency core (Cortex-A725): does specialization help more on a narrower core?",
     "traces": {"records": [1e7]},
     "variants": ["upstream", "legacy", "plan", "jit", "templated_node"], "orders": ["seq", "topo"],
     "fields": ["sim"], "cache": ["warm"], "processes": 3, "reps": 10, "core_class": "slow"},
    {"name": "decode_fields", "kind": "micro",
     "traces": {"schema": ["custom", "wide", "inferred"], "records": [1e6]},
     "variants": ["plan", "jit", "templated_node"], "orders": ["seq"], "fields": ["sim", "all", "scalar"],
     "cache": ["warm"], "processes": 3, "reps": 10},
    {"name": "jit_cold_micro", "kind": "micro",
     "traces": {"records": [1e4], "schema": ["inferred", "custom", "wide"]},
     "variants": ["jit", "orc", "plan"], "orders": ["seq"], "fields": ["sim"], "cache": ["warm"],
     "jit_cold": true, "processes": 3, "reps": 10},
    {"name": "convert", "kind": "convert",
     "traces": {"records": [1e7, 1e8]},
     "tools": ["base-legacy", "master-legacy", "master-sd", "omp-legacy-t1", "omp-legacy-t2", "omp-legacy-t4",
               "omp-legacy-t8", "omp-legacy-t16", "omp-sd-t1", "omp-sd-t2", "omp-sd-t4", "omp-sd-t8", "omp-sd-t16",
               "omp-sd-t20"]},
    {"name": "concurrency", "kind": "concurrent",
     "traces": {"records": [1e7]},
     "configs": ["BASE", "NEW-interp", "NEW-spec-warm", "LAZY-interp"], "k": [1, 2, 4, 8, 10, 20]},
    {"name": "xl", "kind": "e2e",
     "_doc": "1e9 records (~46 GB legacy): large relative to the 112 GiB job memory once dirty pages count. 3 repetitions (documented cap).",
     "traces": {"records": [1e9]},
     "configs": ["BASE", "NEW-interp", "NEW-spec-warm", "LAZY-interp", "LAZY-legacyfile"], "cache": ["warm"]}
  ]
}
