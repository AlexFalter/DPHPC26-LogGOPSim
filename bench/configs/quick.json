{
  "_doc": "Smoke test of the whole harness: a few minutes on a laptop. Not for reportable numbers (few repetitions, tiny traces).",
  "include": ["builds.json", "configs.json"],
  "repetitions": {"warmup": 1, "min": 3, "max": 5, "ci_rel": 0.05, "confidence": 0.95},
  "environment": {"pin": true, "membind": true, "env_padding": true, "noisy_loadavg_per_cpu": 0.5,
                  "timeout_s": 600, "cache_method": "auto"},
  "check": {"viz_max_records": 200000, "byte_identity_max_records": 200000},
  "trace_defaults": {"workload": "stencil3d", "ranks": 16, "records": 1e4, "schema": "inferred"},
  "experiments": [
    {"name": "size_sweep", "kind": "e2e",
     "traces": {"records": [1e4, 1e5]},
     "configs": ["BASE", "NEW-legacyfile", "NEW-interp", "NEW-spec-cold", "NEW-spec-warm", "NEW-orc", "NEW-tnode",
                 "LAZY-interp", "LAZY-legacyfile"],
     "cache": ["warm"]},
    {"name": "schema_sweep", "kind": "e2e",
     "traces": {"schema": ["inferred", "custom", "wide"]},
     "configs": ["BASE", "NEW-interp", "NEW-spec-warm"], "cache": ["warm"]},
    {"name": "workloads", "kind": "e2e",
     "traces": [{"workload": "allreduce_rd", "ranks": 16}, {"workload": "dp_nccl", "ranks": 8, "records": 2e4},
                {"workload": "pipeline_1f1b", "ranks": 8}],
     "configs": ["BASE", "NEW-interp", "LAZY-interp"], "cache": ["warm", "cold"]},
    {"name": "instrumentation_overhead", "kind": "e2e",
     "traces": {"records": [1e5]},
     "configs": ["NEW-interp", "NEW-interp-notiming", "PLAIN-interp"], "cache": ["warm"]},
    {"name": "save_mem", "kind": "e2e",
     "traces": {"records": [1e5]},
     "configs": ["BASE-savemem", "NEW-savemem-interp"], "cache": ["warm"]},
    {"name": "decode_micro", "kind": "micro",
     "traces": {"records": [1e5]},
     "variants": ["upstream", "legacy", "plan", "jit", "orc", "templated_node"],
     "orders": ["seq", "topo"], "fields": ["sim"], "cache": ["warm", "cold"], "processes": 1, "reps": 5},
    {"name": "decode_fields", "kind": "micro",
     "traces": {"schema": ["custom"], "records": [1e5]},
     "variants": ["plan", "jit"], "orders": ["seq"], "fields": ["sim", "all", "scalar"], "cache": ["warm"],
     "processes": 1, "reps": 5},
    {"name": "jit_cold_micro", "kind": "micro",
     "traces": {"records": [1e4]},
     "variants": ["jit", "orc"], "orders": ["seq"], "fields": ["sim"], "cache": ["warm"], "jit_cold": true,
     "processes": 1, "reps": 3},
    {"name": "convert", "kind": "convert",
     "traces": {"records": [1e5]},
     "tools": ["base-legacy", "master-legacy", "master-sd", "omp-legacy-t1", "omp-legacy-t2", "omp-sd-t1", "omp-sd-t2"]},
    {"name": "concurrency", "kind": "concurrent",
     "traces": {"records": [1e5]},
     "configs": ["BASE", "NEW-interp", "LAZY-interp"], "k": [1, 2]}
  ]
}
