package "goalsim" 
version "0.1"

option "input"      i "Input file, textfile containing GOAL schedules" string typestr="filename"
option "output"     o "Output file, will contain the binary representation of the GOAL schedules" string typestr="filename"
option "progress"   p "Print progress information while parsing the schedule" flag off


option "format" - "Binary output format" values="legacy","self-describing" default="legacy" string optional
option "report-schema" - "Print observed ranges and the selected packed schema (a proposal for legacy output)" flag off
option "custom-fields" - "TOML file declaring custom fields (default: config/custom_fields.toml in the source tree; no custom fields if that file is absent)" string typestr="filename" optional
